{
  "name": "hkharpcentre-pos-v2",
  "version": "0.1.0",
  "private": true,
  "description": "Hong Kong Harp Centre On-Prem POS, Invoice AR & Back Office Monorepo (React 19, Next.js 15, MySQL 8, .NET x86 Octopus Bridge)",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/web",
    "apps/worker"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:golden": "npm --workspace @hkharp/domain run test:golden",
    "build": "npm --workspace @hkharp/web run build && npm --workspace @hkharp/worker run typecheck",
    "build:bridge": "dotnet build apps/pos-hardware-bridge/PosHardwareBridge.csproj -c Release",
    "dev": "npm --workspace @hkharp/web run dev",
    "db:generate": "npm --workspace @hkharp/db run db:generate",
    "db:migrate": "node --env-file=.env ./node_modules/tsx/dist/cli.mjs packages/db/src/migrate.ts",
    "db:seed": "node --env-file=.env ./node_modules/tsx/dist/cli.mjs packages/db/src/seed-operational.ts",
    "etl:audit": "npm --workspace @hkharp/etl run audit",
    "etl:migrate": "node --env-file=.env ./node_modules/tsx/dist/cli.mjs packages/etl/src/migrate-v47.ts",
    "etl:verify": "node --env-file=.env ./node_modules/tsx/dist/cli.mjs packages/etl/src/verify-v47.ts"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
